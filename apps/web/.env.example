# Copy to `.env` (or set in CI). Contains placeholders only - never commit real values.
#
# WebSocket endpoint of the Eternal Blocks Cloudflare Worker.
# Local dev (wrangler):  ws://localhost:8787/ws
# Production:            wss://your-worker-name.your-subdomain.workers.dev/ws
VITE_GAME_SERVER_URL=ws://localhost:8787/ws

# Optional base path override for the built site, used by CI for GitHub Pages
# project sites (e.g. /eternal-blocks/). Leave unset for '/'.
VITE_BASE_PATH=
